# Supabase (publik). Ambil dari Project Settings → API di dashboard Supabase.
# Hanya anon/publishable key yang boleh di sini. JANGAN pernah memakai service_role key:
# semua variabel VITE_* ikut ter-bundle ke browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 (Frontend Public Measurement ID)
# Contoh: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Analytics 4 (Serverless Backend Secret - JANGAN GUNAKAN PREFIX VITE_)
# Hanya dipasang di Vercel → Project Settings → Environment Variables
GA_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
