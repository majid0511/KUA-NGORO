# Supabase (publik). Ambil dari Project Settings → API di dashboard Supabase.
# Hanya anon/publishable key yang boleh di sini. JANGAN pernah memakai service_role key:
# semua variabel VITE_* ikut ter-bundle ke browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alamat situs (opsional tapi disarankan di Vercel). Dipakai untuk canonical, pratinjau tautan, robots.txt & sitemap.xml.
# Contoh: https://kua-ngoro.vercel.app  (tanpa garis miring di akhir). Jika kosong, alamat dideteksi otomatis.
VITE_SITE_URL=

# Google Analytics 4 (Frontend Public Measurement ID)
# Contoh: G-FTSFFTVHM1
VITE_GA_MEASUREMENT_ID=

# Statistik di dashboard admin: Vercel Web Analytics API (Serverless Backend Secret - JANGAN GUNAKAN PREFIX VITE_)
# Hanya dipasang di Vercel → Project Settings → Environment Variables (lalu redeploy).
# WEB_ANALYTICS_TOKEN      : token akses Vercel (Account Settings → Tokens). Rahasia, jangan dibagikan.
# WEB_ANALYTICS_PROJECT_ID : ID project, bentuk prj_xxxxxxxx (Project → Settings → General).
# WEB_ANALYTICS_TEAM_ID    : ID team, bentuk team_xxxxxxxx. Isi HANYA jika project milik team; kosongkan untuk akun pribadi.
# Web Analytics juga harus sudah diaktifkan di tab Analytics pada project Vercel.
WEB_ANALYTICS_TOKEN=
WEB_ANALYTICS_PROJECT_ID=
WEB_ANALYTICS_TEAM_ID=
