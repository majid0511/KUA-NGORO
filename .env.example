# Headless CMS Configuration (Sanity.io / Directus / REST API)
# Copy this file to .env and fill in your CMS credentials.

# Sanity.io Project ID & Dataset
VITE_CMS_PROJECT_ID=
VITE_CMS_DATASET=production

# Optional: Generic REST / GraphQL API URL
VITE_CMS_API_URL=

# Optional: Read API Token (if dataset is private)
VITE_CMS_TOKEN=
